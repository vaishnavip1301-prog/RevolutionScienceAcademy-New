@{
    ViewData["Title"] = "About Us";
}

<!-- =========================
     ABOUT HERO
========================= -->
<section class="rsa-about-hero">

    <div class="rsa-about-hero-overlay"></div>

    <div class="container position-relative">
        <div class="row justify-content-center">
            <div class="col-lg-9">

                <div class="rsa-about-hero-content">

                    <span class="rsa-about-label">
                        ABOUT REVOLUTION SCIENCE ACADEMY
                    </span>

                    <h1 class="rsa-about-title">
                        About
                        <span>Revolution Science Academy</span>
                    </h1>

                    <p class="rsa-about-subtitle">
                        Transforming education since 2010 with proven
                        methodologies and exceptional academic results.
                    </p>

                </div>

            </div>
        </div>
    </div>

</section>


<!-- =========================
     FOUNDER / VISION
========================= -->
<section class="rsa-about-section">

    <div class="container">

        <div class="row align-items-center g-5">

            
            <!-- Founder Image -->
            <div class="col-lg-5 order-lg-2">

                <div class="rsa-founder-image-box">

                    <div class="rsa-founder-photo">
                        <img src="~/images/about/patilsir.jpg"
                             alt="Prof. Shrikant Bapurao Patil - Founder and Director" />
                    </div>

                    <div class="rsa-founder-info">

                        <span class="rsa-founder-badge">
                            FOUNDER & DIRECTOR
                        </span>

                        <h2 class="rsa-founder-name">
                            Prof. Shrikant Bapurao Patil
                        </h2>

                        <p class="rsa-founder-role">
                            Founder & Director
                        </p>

                        <p class="rsa-founder-details">
                            B.E. (Civil) &nbsp; | &nbsp;
                            30+ Years Teaching Experience &nbsp; | &nbsp;
                            Mathematics
                        </p>

                    </div>

                </div>

            </div>


            <!-- Vision -->
            <div class="col-lg-7 order-lg-1">

                <div class="rsa-about-content">

                    <span class="rsa-about-section-label">
                        FOUNDER'S VISION
                    </span>

                    <h2 class="rsa-about-heading">
                        Building Academic Excellence
                    </h2>

                    <div class="rsa-about-quote">
                        Revolution Science Academy believes in building
                        strong academic foundations through conceptual
                        clarity, continuous practice and personalized
                        guidance.
                    </div>


                    <!-- Educational Philosophy -->
                    <div class="rsa-about-feature">

                        <div class="rsa-about-feature-icon">
                            <i class="bi bi-mortarboard-fill"></i>
                        </div>

                        <div class="rsa-about-feature-content">

                            <h3>
                                Educational Philosophy
                            </h3>

                            <p>
                                Our scientifically designed learning
                                approach bridges school education and
                                competitive examination requirements.
                                Students are encouraged to understand
                                concepts deeply and apply them confidently.
                            </p>

                        </div>

                    </div>


                    <!-- Achievements -->
                    <div class="rsa-about-feature">

                        <div class="rsa-about-feature-icon">
                            <i class="bi bi-trophy-fill"></i>
                        </div>

                        <div class="rsa-about-feature-content">

                            <h3>
                                Our Achievements
                            </h3>

                            <p>
                                1500+ JEE/NEET selections, 98% Board exam
                                pass rate and 85%+ students scoring above
                                90% in PCMB reflect our result-oriented
                                academic approach.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================
     KEY STATS
========================= -->
<section class="rsa-about-stats">

    <div class="container position-relative">

        <div class="row g-0">

            <!-- Years -->
            <div class="col-6 col-lg-3">

                <div class="rsa-about-stat">

                    <div class="rsa-about-stat-icon">
                        <i class="bi bi-building"></i>
                    </div>

                    <h3 class="rsa-about-stat-number">
                        3+
                    </h3>

                    <p class="rsa-about-stat-label">
                        Years Established
                    </p>

                </div>

            </div>


            <!-- Students -->
            <div class="col-6 col-lg-3">

                <div class="rsa-about-stat">

                    <div class="rsa-about-stat-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>

                    <h3 class="rsa-about-stat-number">
                        5000+
                    </h3>

                    <p class="rsa-about-stat-label">
                        Students Taught
                    </p>

                </div>

            </div>


            <!-- Faculty -->
            <div class="col-6 col-lg-3">

                <div class="rsa-about-stat">

                    <div class="rsa-about-stat-icon">
                        <i class="bi bi-person-workspace"></i>
                    </div>

                    <h3 class="rsa-about-stat-number">
                        25+
                    </h3>

                    <p class="rsa-about-stat-label">
                        Faculty Members
                    </p>

                </div>

            </div>


            <!-- Toppers -->
            <div class="col-6 col-lg-3">

                <div class="rsa-about-stat">

                    <div class="rsa-about-stat-icon">
                        <i class="bi bi-award-fill"></i>
                    </div>

                    <h3 class="rsa-about-stat-number">
                        200+
                    </h3>

                    <p class="rsa-about-stat-label">
                        Toppers Produced
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================
     MISSION
========================= -->
<section class="rsa-about-section rsa-about-section-light">

    <div class="container">

        <div class="row">

            <div class="col-lg-8">

                <span class="rsa-about-section-label">
                    OUR MISSION
                </span>

                <h2 class="rsa-about-heading">
                    Empowering Students Through
                    <span>Quality Education</span>
                </h2>

                <p class="rsa-about-description">
                    Our mission is to provide students with quality
                    education, expert guidance and a supportive learning
                    environment that helps them excel in board examinations
                    and competitive examinations.
                </p>

            </div>

        </div>


        <!-- Mission Cards -->
        <div class="row g-4 mt-4">

            <!-- Teaching Methodology -->
            <div class="col-lg-4">

                <div class="rsa-mission-card">

                    <div class="rsa-mission-icon">
                        <i class="bi bi-book-half"></i>
                    </div>

                    <h3>
                        Teaching Methodology
                    </h3>

                    <p>
                        Concept → Application → Mastery.
                        Our teaching methodology focuses on conceptual
                        clarity, application-based learning, regular
                        assessments and continuous improvement.
                    </p>

                </div>

            </div>


            <!-- Infrastructure -->
            <div class="col-lg-4">

                <div class="rsa-mission-card">

                    <div class="rsa-mission-icon">
                        <i class="bi bi-building"></i>
                    </div>

                    <h3>
                        Infrastructure
                    </h3>

                    <p>
                        Smart classrooms, advanced laboratories and a
                        10,000+ book library provide students with a
                        focused and effective learning environment.
                    </p>

                </div>

            </div>


            <!-- Parent Partnership -->
            <div class="col-lg-4">

                <div class="rsa-mission-card">

                    <div class="rsa-mission-icon">
                        <i class="bi bi-people"></i>
                    </div>

                    <h3>
                        Parent Partnership
                    </h3>

                    <p>
                        Monthly progress reports, dedicated parent
                        communication and counselling help parents
                        stay connected with their child's academic journey.
                    </p>

                </div>

            </div>

        </div>


        <!-- Achievement Box -->
        <div class="rsa-achievement-box">

            <h3>
                Revolution Academy at a Glance
            </h3>

            <div class="row">

                <div class="col-md-6">

                    <div class="rsa-achievement-item">

                        <span class="rsa-achievement-check">
                            <i class="bi bi-check"></i>
                        </span>

                        <span>
                            1500+ JEE/NEET Selections
                        </span>

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="rsa-achievement-item">

                        <span class="rsa-achievement-check">
                            <i class="bi bi-check"></i>
                        </span>

                        <span>
                            98% Board Exam Pass Rate
                        </span>

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="rsa-achievement-item">

                        <span class="rsa-achievement-check">
                            <i class="bi bi-check"></i>
                        </span>

                        <span>
                            85%+ Students Above 90% in PCMB
                        </span>

                    </div>

                </div>


                <div class="col-md-6">

                    <div class="rsa-achievement-item">

                        <span class="rsa-achievement-check">
                            <i class="bi bi-check"></i>
                        </span>

                        <span>
                            Scientifically Designed Curriculum
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>