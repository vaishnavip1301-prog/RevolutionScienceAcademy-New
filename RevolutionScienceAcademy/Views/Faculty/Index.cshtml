                        <div class="faculty-detail">
                            <i class="bi bi-people-fill"></i>
                            <p>Experience details not visible</p>
                        </div>

                        <div class="faculty-detail">
                            <i class="bi bi-lightbulb-fill"></i>
                            <p>Mathematics and Statistics</p>
                        </div>

                        <div class="faculty-achievements">
                            <h4>Achievements</h4>
                            <ul>
                                <li>Mathematics and Statistics education</li>
                                <li>Student academic support</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- Teaching Philosophy -->
<section class="faculty-philosophy">
    <div class="container">

        <div class="faculty-heading">
            <h2>Our Teaching Philosophy</h2>
            <p>Proven methodologies that deliver exceptional results year after year</p>
        </div>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="philosophy-card">
                    <div class="philosophy-icon">
                        <i class="bi bi-lightbulb-fill"></i>
                    </div>
                    <h3>Concept Clarity</h3>
                    <p>Building strong fundamentals before problem-solving</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="philosophy-card">
                    <div class="philosophy-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <h3>Personalized Attention</h3>
                    <p>Small batch sizes with individual mentoring</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="philosophy-card">
                    <div class="philosophy-icon">
                        <i class="bi bi-trophy-fill"></i>
                    </div>
                    <h3>Exam Excellence</h3>
                    <p>Optimized for board and competitive exams</p>
                </div>
            </div>

        </div>
    </div>
</section>