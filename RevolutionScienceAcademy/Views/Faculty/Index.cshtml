@{
    ViewData["Title"] = "Faculty";
}

<!-- Faculty Hero -->
<section class="faculty-hero">
    <div class="faculty-hero-content">
        <h1>Meet Our <span>Expert Faculty</span></h1>
        <p>Learn from the best minds in science education with proven track records</p>
    </div>
</section>

<!-- Faculty Section -->
<section class="faculty-section">
    <div class="container">

        <div class="faculty-heading">
            <h2>Distinguished Educators</h2>
            <p>Our faculty combines academic excellence with years of teaching experience</p>
        </div>

        <div class="row g-4">

            <!-- Dr. Rajesh Kumar -->
            <div class="col-xl-3 col-md-6">
                <div class="faculty-card">
                    <div class="faculty-image">
                        <img src="/images/others/avatar1.jpg" alt="Dr. Rajesh Kumar" />
                    </div>

                    <div class="faculty-content">
                        <div class="faculty-name">
                            <i class="bi bi-mortarboard-fill"></i>
                            <div>
                                <h3>Dr. Rajesh Kumar</h3>
                                <span>Physics Department Head</span>
                            </div>
                        </div>

                        <div class="faculty-detail">
                            <i class="bi bi-book-fill"></i>
                            <p>Ph.D. in Physics, IIT Bombay</p>
                        </div>

                        <div class="faculty-detail">
                            <i class="bi bi-people-fill"></i>
                            <p>18+ years experience</p>
                        </div>

                        <div class="faculty-detail">
                            <i class="bi bi-lightbulb-fill"></i>
                            <p>Electrodynamics &amp; Modern Physics</p>
                        </div>

                        <div class="faculty-achievements">
                            <h4>Achievements</h4>
                            <ul>
                                <li>Physics education and mentoring</li>
                                <li>Concept-focused teaching</li>
                                <li>Student academic guidance</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Prof. Meena Sharma -->
            <div class="col-xl-3 col-md-6">
                <div class="faculty-card">
                    <div class="faculty-image">
                        <img src="/images/others/avatar2.jpg" alt="Prof. Meena Sharma" />
                    </div>

                    <div class="faculty-content">
                        <div class="faculty-name">
                            <i class="bi bi-mortarboard-fill"></i>
                            <div>
                                <h3>Prof. Meena Sharma</h3>
                                <span>Chemistry Mentor</span>
                            </div>
                        </div>

                        <div class="faculty-detail">
                            <i class="bi bi-book-fill"></i>
                            <p>M.Sc. Chemistry, BITS Pilani</p>
                        </div>

                        <div class="faculty-detail">
                            <i class="bi bi-people-fill"></i>
                            <p>15 years experience</p>
                        </div>

                        <div class="faculty-detail">
                            <i class="bi bi-lightbulb-fill"></i>
                            <p>Chemistry Education</p>
                        </div>

                        <div class="faculty-achievements">
                            <h4>Achievements</h4>
                            <ul>
                                <li>Chemistry concept development</li>
                                <li>Student mentoring</li>
                                <li>Academic preparation</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Dr. Amit Patel -->
            <div class="col-xl-3 col-md-6">
                <div class="faculty-card">
                    <div class="faculty-image">
                        <img src="/images/others/avatar3.jpg" alt="Dr. Amit Patel" />
                    </div>

                    <div class="faculty-content">
                        <div class="faculty-name">
                            <i class="bi bi-mortarboard-fill"></i>
                            <div>
                                <h3>Dr. Amit Patel</h3>
                                <span>Mathematics Professor</span>
                            </div>
                        </div>

                        <div class="faculty-detail">
                            <i class="bi bi-book-fill"></i>
                            <p>Ph.D. Mathematics, ISI Kolkata</p>
                        </div>

                        <div class="faculty-detail">
                            <i class="bi bi-people-fill"></i>
                            <p>12 years experience</p>
                        </div>

                        <div class="faculty-detail">
                            <i class="bi bi-lightbulb-fill"></i>
                            <p>Calculus &amp; Algebra</p>
                        </div>

                        <div class="faculty-achievements">
                            <h4>Achievements</h4>
                            <ul>
                                <li>Mathematics teaching</li>
                                <li>Problem-solving guidance</li>
                                <li>Competitive exam preparation</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Prof. Shital Mishra -->
            <div class="col-xl-3 col-md-6">
                <div class="faculty-card">
                    <div class="faculty-image">
                        <img src="/images/others/avatar2.jpg" alt="Prof. Shital Mishra" />
                    </div>

                    <div class="faculty-content">
                        <div class="faculty-name">
                            <i class="bi bi-mortarboard-fill"></i>
                            <div>
                                <h3>Prof. Shital Mishra</h3>
                                <span>Faculty Member</span>
                            </div>
