    <!-- ================= ENQUIRY MODAL ================= -->

    <div class="modal fade rsa-enquiry-modal"
         id="enquiryModal"
         tabindex="-1"
         aria-labelledby="enquiryModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">
                    <div>
                        <span class="rsa-enquiry-label">
                            REVOLUTION SCIENCE ACADEMY
                        </span>

                        <h5 class="modal-title" id="enquiryModalLabel">
                            Enquire Now
                        </h5>

                        <p class="mb-0">
                            Our academic counselor will contact you.
                        </p>
                    </div>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">

                    <form asp-controller="Enquiry"
                          asp-action="Index"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div class="row g-3">

                            <div class="col-12">
                                <label for="StudentName" class="form-label">
                                    Student Full Name *
                                </label>

                                <input type="text"
                                       id="StudentName"
                                       name="StudentName"
                                       class="form-control"
                                       placeholder="Enter full name"
                                       autocomplete="name"
                                       required />
                            </div>

                            <div class="col-md-6">
                                <label for="Phone" class="form-label">
                                    Phone Number *
                                </label>

                                <input type="tel"
                                       id="Phone"
                                       name="Phone"
                                       class="form-control"
                                       placeholder="Enter phone number"
                                       autocomplete="tel"
                                       required />
                            </div>

                            <div class="col-md-6">
                                <label for="Email" class="form-label">
                                    Email Address
                                </label>

                                <input type="email"
                                       id="Email"
                                       name="Email"
                                       class="form-control"
                                       placeholder="Enter email"
                                       autocomplete="email" />
                            </div>

                            <div class="col-12">
                                <label for="Course" class="form-label">
                                    Course Interested In *
                                </label>

                                <select id="Course"
                                        name="Course"
                                        class="form-select"
                                        required>

                                    <option value="">Select Course</option>
                                    <option value="11th Science">11th Science Foundation</option>
                                    <option value="12th Science">12th Science Intensive</option>
                                    <option value="JEE">JEE Preparation</option>
                                    <option value="NEET">NEET Preparation</option>
                                    <option value="Board Exam">Board Exam Special</option>
                                </select>
                            </div>

                            <div class="col-12">
                                <label for="Message" class="form-label">
                                    Message
                                </label>

                                <textarea id="Message"
                                          name="Message"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Write your message..."></textarea>
                            </div>

                            <div class="col-12">
                                <button type="submit"
                                        class="btn rsa-enquiry-submit w-100">
                                    <i class="bi bi-send-fill me-2"></i>
                                    Submit Enquiry
                                </button>
                            </div>

                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>

    
                    <!-- Registration Modal -->
                        <div class="modal fade" id="registerModal" tabindex="-1"
                     aria-labelledby="registerModalLabel" aria-hidden="true">

                        <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content register-modal">

            <div class="modal-header register-modal-header">
                <div>
                <h5 class="modal-title fw-bold" id="registerModalLabel">
            Student Registration
                    </h5>
            <p class="mb-0 small">
                Revolution Science Academy
                </p>
                </div>

                <button type="button" class="btn-close btn-close-white"
                        data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

                        <form asp-controller="Register"
                      asp-action="Submit"
                  method="post">

                @Html.AntiForgeryToken()

                            <div class="modal-body p-4">

                            <p class="text-muted mb-4">
                            Please fill in your details to apply for admission.
                            </p>

                    <div class="row g-3">

                            <div class="col-md-6">
                            <label class="form-label">Student Full Name *</label>
                            <input type="text" name="StudentName"
                                   class="form-control"
                                   placeholder="Enter student name"
                               maxlength="100" required />
                        </div>

                            <div class="col-md-6">
                            <label class="form-label">Parent / Guardian Name *</label>
                            <input type="text" name="ParentName"
                                   class="form-control"
                                   placeholder="Enter parent name"
                                   maxlength="100" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Student Mobile Number *</label>
                            <input type="tel" name="MobileNumber"
                                   class="form-control"
                                   placeholder="10-digit mobile number"
                                   pattern="[6-9][0-9]{9}"
                                   maxlength="10" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Parent Mobile Number</label>
                            <input type="tel" name="ParentMobileNumber"
                                   class="form-control"
                                   placeholder="Parent's mobile number"
                                   pattern="[6-9][0-9]{9}"
                               maxlength="10" />
                        </div>

                            <div class="col-md-6">
                            <label class="form-label">Email Address</label>
                            <input type="email" name="Email"
                                   class="form-control"
                                   placeholder="example@email.com"
                               maxlength="150" />
                        </div>

                            <div class="col-md-6">
                            <label class="form-label">Date of Birth *</label>
                                <input type="date" name="DateOfBirth"
                                       class="form-control"
                                       max="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Select Class *</label>
                            <select name="ClassName" class="form-select" required>
                                <option value="">Choose class</option>
                                <option value="11th Science">11th Science</option>
                                <option value="12th Science">12th Science</option>
                                </select>
                            </div>

                        <div class="col-md-6">
                        <label class="form-label">Select Course *</label>
                            <select name="CourseName" class="form-select" required>
                            <option value="">Choose course</option>
                            <option value="Board Exam">Board Exam Preparation</option>
                            <option value="JEE">JEE Preparation</option>
                            <option value="NEET">NEET Preparation</option>
                        </select>
                        </div>

                <div class="col-12">
                            <label class="form-label">Full Address *</label>
                <textarea name="Address" class="form-control"
                              rows="3" maxlength="500"
                                  placeholder="Enter your full address"
                                  required></textarea>
                    </div>

                    </div>
                        </div>

                    <div class="modal-footer register-modal-footer">
                <button type="button" class="btn btn-light border"
                            data-bs-dismiss="modal">
            Cancel
        </button>

<button type="submit" class="btn register-submit-btn">
<i class="bi bi-check-circle me-1"></i>
Submit Registration
                    </button>
    </div>

        </form>
        </div>
            </div>
            </div>

