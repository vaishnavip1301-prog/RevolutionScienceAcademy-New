<!-- DETAILED SUBJECTS -->
<section class="jee-section jee-syllabus-section" id="syllabus">
    <div class="container">
        <div class="jee-section-heading text-center">
            <span class="jee-kicker">EXPLORE THE SUBJECTS</span>
            <h2>Detailed JEE Subject Guide</h2>

            <p>
                Each subject develops a different set of skills.
                Explore these example topic areas to understand what
                your preparation may cover.
            </p>
        </div>

        <div class="row g-4 mt-3">
            <div class="col-lg-4">
                <div class="jee-subject-card">
                    <div class="jee-subject-top physics-top">
                        <span class="jee-subject-symbol">Φ</span>
                        <span class="jee-subject-number">SUBJECT 01</span>
                        <h3>Physics</h3>
                        <p>Understand the principles behind the physical world.</p>
                    </div>

                    <div class="jee-subject-content">
                        <h5>Example topic areas</h5>

                        <ul>
                            <li>Units, Dimensions and Measurements</li>
                            <li>Motion and Laws of Motion</li>
                            <li>Work, Energy and Power</li>
                            <li>Rotational Motion</li>
                            <li>Thermodynamics</li>
                            <li>Electrostatics and Current Electricity</li>
                            <li>Magnetism and Electromagnetic Induction</li>
                            <li>Optics and Modern Physics</li>
                        </ul>

                        <div class="jee-skill-note">
                            <strong>Skills developed</strong>
                            <p>
                                Numerical accuracy, mathematical application
                                and physical reasoning.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="jee-subject-card">
                    <div class="jee-subject-top chemistry-top">
                        <span class="jee-subject-symbol">⚗</span>
                        <span class="jee-subject-number">SUBJECT 02</span>
                        <h3>Chemistry</h3>
                        <p>Connect chemical principles with reactions and structures.</p>
                    </div>

                    <div class="jee-subject-content">
                        <h5>Example topic areas</h5>

                        <ul>
                            <li>Mole Concept and Stoichiometry</li>
                            <li>Atomic Structure</li>
                            <li>Chemical Bonding</li>
                            <li>Chemical and Ionic Equilibrium</li>
                            <li>Thermodynamics</li>
                            <li>Organic Chemistry Fundamentals</li>
                            <li>Hydrocarbons and Functional Groups</li>
                            <li>Inorganic Chemistry Topics</li>
                        </ul>

                        <div class="jee-skill-note">
                            <strong>Skills developed</strong>
                            <p>
                                Chemical reasoning, reaction understanding,
                                calculations and conceptual recall.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="jee-subject-card">
                    <div class="jee-subject-top maths-top">
                        <span class="jee-subject-symbol">∑</span>
                        <span class="jee-subject-number">SUBJECT 03</span>
                        <h3>Mathematics</h3>
                        <p>Build logical thinking and systematic problem-solving skills.</p>
                    </div>

                    <div class="jee-subject-content">
                        <h5>Example topic areas</h5>

                        <ul>
                            <li>Sets, Relations and Functions</li>
                            <li>Quadratic Equations and Algebra</li>
                            <li>Complex Numbers</li>
                            <li>Sequences and Series</li>
                            <li>Trigonometry</li>
                            <li>Coordinate Geometry</li>
                            <li>Differential and Integral Calculus</li>
                            <li>Vectors and Three-Dimensional Geometry</li>
                        </ul>

                        <div class="jee-skill-note">
                            <strong>Skills developed</strong>
                            <p>
                                Logical reasoning, multi-step calculations,
                                analytical thinking and accuracy.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="jee-syllabus-notice mt-4">
            <strong>Important syllabus note:</strong>
            The topics above are illustrative, not a complete or guaranteed
            current syllabus. The applicable official syllabus for the
            examination year must be checked before finalising a study plan.

            <a href="https://jeemain.nta.nic.in/document/syllabus-2026/"
               target="_blank"
               rel="noopener noreferrer">
                Check the official JEE Main syllabus ↗
            </a>
        </div>
    </div>
</section>

<!-- LEARNING METHOD -->
<section class="jee-section">
    <div class="container">
        <div class="jee-section-heading text-center">
            <span class="jee-kicker">HOW YOU WILL LEARN</span>
            <h2>From Understanding to Problem-Solving</h2>

            <p>
                A structured learning process helps students move
                from basic understanding to independent problem-solving.
            </p>
        </div>

        <div class="jee-learning-timeline mt-5">
            <div class="jee-timeline-item">
                <div class="jee-timeline-number">01</div>
                <div>
                    <h4>Concept Learning</h4>
                    <p>
                        Learn the fundamental ideas, formulas and principles
                        behind each topic before attempting complex questions.
                    </p>
                </div>
            </div>

            <div class="jee-timeline-item">
                <div class="jee-timeline-number">02</div>
                <div>
                    <h4>Guided Question Practice</h4>
                    <p>
                        Begin with basic examples, understand the solution
                        method and gradually progress to more challenging problems.
                    </p>
                </div>
            </div>

            <div class="jee-timeline-item">
                <div class="jee-timeline-number">03</div>
                <div>
                    <h4>Independent Practice</h4>
                    <p>
                        Solve questions independently to identify gaps in
                        understanding and strengthen problem-solving ability.
                    </p>
                </div>
            </div>

            <div class="jee-timeline-item">
                <div class="jee-timeline-number">04</div>
                <div>
                    <h4>Revision and Assessment</h4>
                    <p>
                        Review important concepts, analyse mistakes and use
                        practice tests to track improvement over time.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- MAIN VS ADVANCED -->
<section class="jee-comparison-section">
    <div class="container">
        <div class="jee-section-heading text-center">
            <span class="jee-kicker">KNOW THE DIFFERENCE</span>
            <h2>JEE Main vs JEE Advanced</h2>

            <p>
                Both examinations are part of the engineering admission
                pathway, but they serve different purposes.
            </p>
        </div>

        <div class="table-responsive mt-4">
            <table class="table jee-comparison-table align-middle">
                <thead>
                    <tr>
                        <th>Feature</th>
                        <th>JEE Main</th>
                        <th>JEE Advanced</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <th>Primary purpose</th>
                        <td>
                            Admission to NITs, IIITs and other participating
                            institutions, subject to their rules.
                        </td>
                        <td>
                            Admission to IITs, subject to the applicable
                            eligibility and admission requirements.
                        </td>
                    </tr>

                    <tr>
                        <th>Eligibility route</th>
                        <td>
                            Candidates must meet the current examination
                            and institution-specific eligibility criteria.
                        </td>
                        <td>
                            Candidates must meet the specific JEE Advanced
                            eligibility criteria, including applicable
                            JEE Main qualification requirements.
                        </td>
                    </tr>

                    <tr>
                        <th>Preparation focus</th>
                        <td>
                            Syllabus coverage, conceptual clarity,
                            accuracy and time management.
                        </td>
                        <td>
                            Deep conceptual understanding and solving
                            complex, multi-step problems.
                        </td>
                    </tr>

                    <tr>
                        <th>Exam pattern</th>
                        <td>
                            Follow the current official JEE Main
                            information bulletin.
                        </td>
                        <td>
                            Follow the current official JEE Advanced
                            information brochure.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <p class="jee-small-note">
            Eligibility, examination pattern and admission rules can change.
            Always check the official documents for the relevant year.
        </p>
    </div>
</section>

<!-- STUDY ROADMAP -->
<section class="jee-section">
    <div class="container">
        <div class="jee-section-heading text-center">
            <span class="jee-kicker">PLAN YOUR PREPARATION</span>
            <h2>A Practical Study Roadmap</h2>

            <p>
                Use a consistent study routine and adapt it to your school
                timetable, current understanding and remaining preparation time.
            </p>
        </div>

        <div class="row g-4 mt-3">
            <div class="col-md-6 col-lg-3">
                <div class="jee-roadmap-card">
                    <span>PHASE 01</span>
                    <h4>Build the Basics</h4>
                    <p>
                        Understand fundamental concepts and keep your
                        class notes and formulas organised.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="jee-roadmap-card">
                    <span>PHASE 02</span>
                    <h4>Practise by Topic</h4>
                    <p>
                        Solve graded questions after each topic and
                        revisit concepts that are difficult.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="jee-roadmap-card">
                    <span>PHASE 03</span>
                    <h4>Revise Regularly</h4>
                    <p>
                        Revisit completed topics and practise mixed
                        questions to strengthen retention.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="jee-roadmap-card">
                    <span>PHASE 04</span>
                    <h4>Assess Progress</h4>
                    <p>
                        Attempt suitable mock tests, analyse errors
                        and refine your study strategy.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

