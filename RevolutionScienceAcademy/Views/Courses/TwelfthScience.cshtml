@{
    ViewData["Title"] = "12th Science Courses";
}

<!-- Hero Section -->
<section class="science-hero">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <span class="science-badge">REVOLUTION SCIENCE ACADEMY</span>

                <h1>
                    12th Science <span>Coaching Classes</span>
                </h1>

                <p class="science-hero-text">
                    Build strong concepts, prepare for board examinations
                    and take the next step towards your academic goals
                    with expert guidance and regular practice.
                </p>

                <div class="science-hero-buttons">
                    <a href="#subjects" class="btn btn-warning btn-lg">
                        Explore Subjects
                    </a>

                    @* <a href="#enquiry" class="btn btn-outline-light btn-lg">
                        Enquire Now
                    </a> *@
                </div>

                <div class="science-highlights">
                    <div>
                        <strong>12th</strong>
                        <span>Science</span>
                    </div>
                    <div>
                        <strong>Board</strong>
                        <span>Exam Preparation</span>
                    </div>
                    <div>
                        <strong>JEE / NEET</strong>
                        <span>Entrance Preparation</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="science-hero-image">
                    <img src="~/images/courses/12th-science.jpg"
                         asp-append-version="true"
                         alt="12th Science students studying"
                         class="img-fluid" />
                    <div class="science-image-caption">
                        <span>Learn with Confidence</span>
                        <strong>Your Future Starts Here!</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Introduction -->
<section class="science-intro section-space">
    <div class="container">
        <div class="section-heading text-center">
            <span class="section-kicker">WELCOME TO REVOLUTION</span>
            <h2>Make Your 12th Science Year Count</h2>
            <p>
                Strengthen your fundamentals, practise important questions
                and prepare systematically for board and entrance examinations.
            </p>
        </div>

        <div class="row g-4 mt-3">
            <div class="col-md-4">
                <div class="science-info-card">
                    <div class="science-card-icon">01</div>
                    <h4>Concept-Based Learning</h4>
                    <p>
                        Understand important concepts through clear
                        explanations and guided classroom learning.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="science-info-card">
                    <div class="science-card-icon">02</div>
                    <h4>Regular Practice</h4>
                    <p>
                        Improve accuracy and confidence through practice
                        questions, revision and assessments.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="science-info-card">
                    <div class="science-card-icon">03</div>
                    <h4>Exam Preparation</h4>
                    <p>
                        Prepare with a structured approach to syllabus
                        coverage, important topics and exam revision.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Subjects -->
<section class="science-subjects section-space" id="subjects">
    <div class="container">
        <div class="section-heading text-center">
            <span class="section-kicker">OUR ACADEMIC PROGRAM</span>
            <h2>12th Science Subjects</h2>
            <p>Build a strong foundation across your core science subjects.</p>
        </div>

        <div class="row g-4 mt-3">
            <div class="col-sm-6 col-lg-3">
                <div class="subject-card">
                    <div class="subject-icon">∑</div>
                    <h4>Mathematics</h4>
                    <p>Practise formulas, problem-solving and important concepts.</p>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="subject-card">
                    <div class="subject-icon">⚛</div>
                    <h4>Physics</h4>
                    <p>Understand physical principles, numericals and applications.</p>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="subject-card">
                    <div class="subject-icon">🧪</div>
                    <h4>Chemistry</h4>
                    <p>Learn chemical concepts, reactions and numerical methods.</p>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="subject-card">
                    <div class="subject-icon">🧬</div>
                    <h4>Biology</h4>
                    <p>Revise biological concepts, diagrams and key terminology.</p>
                </div>
            </div>
        </div>

        <p class="science-note text-center mt-4">
            *Subject combinations and available batches depend on the
            academy's current course offerings.
        </p>
    </div>
</section>

<!-- Learning Process -->
<section class="science-process section-space">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="section-kicker">OUR LEARNING APPROACH</span>
                <h2 class="process-heading">
                    Learn. Practise. Revise. Achieve.
                </h2>
                <p class="text-secondary">
                    A consistent study routine helps students understand
                    concepts, identify learning gaps and prepare effectively
                    for important examinations.
                </p>

                <ul class="science-check-list">
                    <li>Concept explanations and guided learning</li>
                    <li>Topic-wise practice and doubt-solving</li>
                    <li>Revision of important concepts</li>
                    <li>Board examination preparation</li>
                    <li>Guidance for entrance exam preparation, where offered</li>
                </ul>
            </div>

            <div class="col-lg-6">
                <div class="process-panel">
                    <span class="process-panel-label">YOUR STUDY JOURNEY</span>

                    <div class="process-step">
                        <span>01</span>
                        <div>
                            <h5>Understand</h5>
                            <p>Build clarity in fundamental concepts.</p>
                        </div>
                    </div>

                    <div class="process-step">
                        <span>02</span>
                        <div>
                            <h5>Practise</h5>
                            <p>Apply what you learn to questions and problems.</p>
                        </div>
                    </div>

                    <div class="process-step">
                        <span>03</span>
                        <div>
                            <h5>Revise</h5>
                            <p>Review topics and work on areas for improvement.</p>
                        </div>
                    </div>

                    <div class="process-step">
                        <span>04</span>
                        <div>
                            <h5>Prepare</h5>
                            <p>Approach examinations with a structured study plan.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Enquiry CTA -->
<section class="science-enquiry section-space" id="enquiry">
    <div class="container">
        <div class="science-enquiry-content text-center">
            <span class="science-badge">START YOUR JOURNEY</span>
            <h2>Ready to Begin Your 12th Science Preparation?</h2>
            <p>
                Contact Revolution Science Academy to learn about available
                batches, subjects, fees and admission details.
            </p>

            <a asp-controller="Contact"
               asp-action="Index"
               class="btn btn-warning btn-lg">
                Contact Academy
            </a>
        </div>
    </div>
</section>
