@{
    ViewData["Title"] = "11th Science Courses";
}

<!-- Hero Section -->
<section class="science-hero">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <span class="science-badge">
                    REVOLUTION SCIENCE ACADEMY
                </span>

                <h1>
                    11th Science
                    <span>Foundation Coaching</span>
                </h1>

                <p class="science-hero-text">
                    Start your science journey with strong fundamentals,
                    clear concepts and guided practice. Build the foundation
                    you need for 11th and 12th Science, board examinations
                    and future entrance exam preparation.
                </p>

                <div class="science-hero-buttons">
                    <a href="#subjects" class="btn btn-warning btn-lg">
                        Explore Subjects
                    </a>

                    @* <a href="#enquiry" class="btn btn-outline-light btn-lg">
                        Enquire Now
                    </a> *@
                </div>

                <div class="science-highlights">
                    <div>
                        <strong>11th</strong>
                        <span>Science Foundation</span>
                    </div>

                    <div>
                        <strong>Concepts</strong>
                        <span>Strong Fundamentals</span>
                    </div>

                    <div>
                        <strong>Practice</strong>
                        <span>Regular Revision</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="science-hero-image">
                    <img src="~/images/courses/11th-science.jpg"
                         asp-append-version="true"
                         alt="Students learning science"
                         class="img-fluid" />

                    <div class="science-image-caption">
                        <span>Build Your Foundation</span>
                        <strong>Your Science Journey Starts Here!</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Introduction Section -->
<section class="science-intro section-space">
    <div class="container">
        <div class="section-heading text-center">
            <span class="section-kicker">
                BEGIN YOUR SCIENCE JOURNEY
            </span>

            <h2>Build Strong Fundamentals in 11th Science</h2>

            <p>
                Class 11 is an important step in science education.
                Develop conceptual understanding, improve problem-solving
                skills and build effective study habits with structured learning.
            </p>
        </div>

        <div class="row g-4 mt-3">
            <div class="col-md-4">
                <div class="science-info-card">
                    <div class="science-card-icon">01</div>

                    <h4>Strong Fundamentals</h4>

                    <p>
                        Understand the basic principles of Physics,
                        Chemistry, Mathematics and Biology through
                        clear explanations and guided learning.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="science-info-card">
                    <div class="science-card-icon">02</div>

                    <h4>Conceptual Learning</h4>

                    <p>
                        Focus on understanding concepts instead of
                        memorising answers. Develop logical thinking
                        and problem-solving skills.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="science-info-card">
                    <div class="science-card-icon">03</div>

                    <h4>Regular Practice</h4>

                    <p>
                        Strengthen your understanding with topic-wise
                        questions, revision and assessments based on
                        the available course plan.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Subjects Section -->
<section class="science-subjects section-space" id="subjects">
    <div class="container">
        <div class="section-heading text-center">
            <span class="section-kicker">
                EXPLORE YOUR SUBJECTS
            </span>

            <h2>11th Science Subjects</h2>

            <p>
                Develop a solid academic foundation through important
                concepts and systematic subject-wise preparation.
            </p>
        </div>

        <div class="row g-4 mt-3">
            <div class="col-sm-6 col-lg-3">
                <div class="subject-card">
                    <div class="subject-icon">∑</div>

                    <h4>Mathematics</h4>

                    <p>
                        Learn mathematical concepts, formulas,
                        logical reasoning and problem-solving techniques.
                    </p>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="subject-card">
                    <div class="subject-icon">⚛</div>

                    <h4>Physics</h4>

                    <p>
                        Understand motion, forces, measurements
                        and the fundamental principles of physics.
                    </p>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="subject-card">
                    <div class="subject-icon">🧪</div>

                    <h4>Chemistry</h4>

                    <p>
                        Build a foundation in chemical concepts,
                        atomic structure and chemical reactions.
                    </p>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="subject-card">
                    <div class="subject-icon">🧬</div>

                    <h4>Biology</h4>

                    <p>
                        Explore living organisms, biological processes
                        and the fundamentals of life sciences.
                    </p>
                </div>
            </div>
        </div>

        <p class="science-note text-center mt-4">
            *Available subjects and combinations depend on the
            academy's actual course offerings.
        </p>
    </div>
</section>

<!-- Learning Approach Section -->
<section class="science-process section-space">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="section-kicker">
                    OUR LEARNING APPROACH
                </span>

                <h2 class="process-heading">
                    Learn Today. Build a Stronger Tomorrow.
                </h2>

                <p class="text-secondary">
                    A good foundation in Class 11 makes it easier to
                    understand advanced topics in Class 12. Consistent
                    practice and revision help students improve their
                    confidence throughout the academic year.
                </p>

                <ul class="science-check-list">
                    <li>Clear explanations of fundamental concepts</li>
                    <li>Topic-wise learning and guided practice</li>
                    <li>Regular revision of important concepts</li>
                    <li>Practice questions and academic assessments</li>
                    <li>Preparation for the next stage of science education</li>
                </ul>
            </div>

            <div class="col-lg-6">
                <div class="process-panel">
                    <span class="process-panel-label">
                        YOUR LEARNING JOURNEY
                    </span>

                    <div class="process-step">
                        <span>01</span>

                        <div>
                            <h5>Learn the Basics</h5>

                            <p>
                                Start with essential concepts and
                                understand the fundamentals.
                            </p>
                        </div>
                    </div>

                    <div class="process-step">
                        <span>02</span>

                        <div>
                            <h5>Understand the Concepts</h5>

                            <p>
                                Connect concepts with examples
                                and practical applications.
                            </p>
                        </div>
                    </div>

                    <div class="process-step">
                        <span>03</span>

                        <div>
                            <h5>Practise and Revise</h5>

                            <p>
                                Solve questions and revise topics
                                to improve your understanding.
                            </p>
                        </div>
                    </div>

                    <div class="process-step">
                        <span>04</span>

                        <div>
                            <h5>Prepare for the Future</h5>

                            <p>
                                Build the academic foundation
                                needed for Class 12 and beyond.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Enquiry Section -->
<section class="science-enquiry section-space" id="enquiry">
    <div class="container">
        <div class="science-enquiry-content text-center">
            <span class="science-badge">
                START YOUR JOURNEY
            </span>

            <h2>Ready to Begin Your 11th Science Journey?</h2>

            <p>
                Contact Revolution Science Academy to know more about
                available batches, subjects, fees and admission details.
            </p>

            <a asp-controller="Contact"
               asp-action="Index"
               class="btn btn-warning btn-lg">
                Contact Academy
            </a>
        </div>
    </div>
</section>
