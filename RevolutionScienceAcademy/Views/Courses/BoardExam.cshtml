@{
    ViewData["Title"] = "Board Exam Preparation";
}

<!-- HERO SECTION -->
<section class="neet-hero">
    <div class="container">
        <div class="row align-items-center g-5">

            <div class="col-lg-7">
                <span class="neet-eyebrow">
                    REVOLUTION SCIENCE ACADEMY
                </span>

                <h1>
                    Build Your Foundation.
                    <span>Prepare for Board Exam Success.</span>
                </h1>

                <p class="neet-hero-description">
                    Prepare for Maharashtra State Board examinations
                    with concept-based learning, regular practice,
                    chapter-wise revision and effective answer-writing
                    techniques for 11th and 12th Science.
                </p>

                <div class="neet-hero-actions">
                    <a href="#board-courses"
                       class="btn btn-warning btn-lg">
                        Explore Courses
                    </a>

                    @* <a asp-controller="Home"
                       asp-action="Contact"
                       class="btn btn-outline-light btn-lg">
                        Enquire Now
                    </a> *@
                </div>

                <div class="neet-hero-highlights">
                    <div>
                        <strong>Concepts</strong>
                        <span>Strong Fundamentals</span>
                    </div>

                    <div>
                        <strong>Practice</strong>
                        <span>Regular Assessments</span>
                    </div>

                    <div>
                        <strong>Revision</strong>
                        <span>Exam Preparation</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="neet-hero-image">
                    <img src="~/images/courses/board-exam.jpg"
                         asp-append-version="true"
                         alt="Student preparing for 11th and 12th Science board examinations"
                         class="img-fluid" />

                    <div class="neet-image-caption">
                        <span>YOUR ACADEMIC JOURNEY</span>
                        <strong>Learn with Purpose. Prepare with Confidence.</strong>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- COURSE INTRODUCTION -->
<section class="neet-section" id="board-courses">
    <div class="container">

        <div class="neet-section-heading text-center">
            <span class="neet-kicker">OUR BOARD COURSES</span>

            <h2>Choose Your Science Class</h2>

            <p>
                Build a strong academic foundation with structured
                preparation for 11th and 12th Science students.
            </p>
        </div>

        <div class="row g-4 mt-3">

            <div class="col-md-6">
                <div class="neet-info-card h-100">
                    <div class="neet-card-number">01</div>

                    <span class="neet-kicker">FOUNDATION LEVEL</span>

                    <h3>11th Science Board Preparation</h3>

                    <p>
                        Develop a clear understanding of fundamental
                        concepts and prepare for the academic requirements
                        of higher secondary Science.
                    </p>

                    <h5 class="mt-4">Key Learning Areas</h5>

                    <ul class="list-unstyled mt-3">
                        <li class="mb-3">
                            <i class="bi bi-check-circle-fill text-primary me-2"></i>
                            Physics concepts and numerical problems
                        </li>
                        <li class="mb-3">
                            <i class="bi bi-check-circle-fill text-primary me-2"></i>
                            Chemistry fundamentals and reactions
                        </li>
                        <li class="mb-3">
                            <i class="bi bi-check-circle-fill text-primary me-2"></i>
                            Mathematics or Biology, as applicable
                        </li>
                        <li class="mb-3">
                            <i class="bi bi-check-circle-fill text-primary me-2"></i>
                            English and other prescribed subjects
                        </li>
                        <li>
                            <i class="bi bi-check-circle-fill text-primary me-2"></i>
                            Chapter-wise practice and revision
                        </li>
                    </ul>

                    <a asp-controller="Home"
                       asp-action="Contact"
                       class="btn btn-outline-primary mt-3">
                        Enquire About 11th Science
                        <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>

            <div class="col-md-6">
                <div class="neet-info-card h-100">
                    <div class="neet-card-number">02</div>

                    <span class="neet-kicker">BOARD EXAM FOCUS</span>

                    <h3>12th Science Board Preparation</h3>

                    <p>
                        Prepare for HSC examinations with focused
                        syllabus coverage, written-answer practice,
                        revision and mock tests.
                    </p>

                    <h5 class="mt-4">Key Learning Areas</h5>

                    <ul class="list-unstyled mt-3">
                        <li class="mb-3">
                            <i class="bi bi-check-circle-fill text-primary me-2"></i>
                            Physics theory, derivations and numericals
                        </li>
                        <li class="mb-3">
                            <i class="bi bi-check-circle-fill text-primary me-2"></i>
                            Chemistry concepts and reactions
                        </li>
                        <li class="mb-3">
                            <i class="bi bi-check-circle-fill text-primary me-2"></i>
                            Mathematics or Biology preparation
                        </li>
                        <li class="mb-3">
                            <i class="bi bi-check-circle-fill text-primary me-2"></i>
                            English and other prescribed subjects
                        </li>
                        <li>
                            <i class="bi bi-check-circle-fill text-primary me-2"></i>
                            Model papers and timed practice tests
                        </li>
                    </ul>

                    <a asp-controller="Home"
                       asp-action="Contact"
                       class="btn btn-outline-primary mt-3">
                        Enquire About 12th Science
                        <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- SUBJECTS SECTION -->
<section class="neet-section neet-subjects-section">
    <div class="container">

        <div class="neet-section-heading text-center">
            <span class="neet-kicker">SUBJECT-WISE LEARNING</span>

            <h2>Explore Your Science Subjects</h2>

            <p>
                Focus on understanding concepts, solving problems
                and practising answers for your board examinations.
            </p>
        </div>

        <div class="row g-4 mt-3">

            <div class="col-sm-6 col-lg-3">
                <div class="neet-subject-card h-100">
                    <div class="neet-subject-header physics-header">
                        <span class="neet-subject-symbol">PHY</span>
                        <span class="neet-subject-label">SUBJECT 01</span>

                        <h3>Physics</h3>

                        <p>
                            Understand physical principles and apply
                            formulas to solve numerical problems.
                        </p>
                    </div>

                    <div class="neet-subject-body">
                        <h5>Preparation Focus</h5>
                        <ul>
                            <li>Conceptual understanding</li>
                            <li>Important derivations</li>
                            <li>Numerical practice</li>
                            <li>Formula revision</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="neet-subject-card h-100">
                    <div class="neet-subject-header chemistry-header">
                        <span class="neet-subject-symbol">CHE</span>
                        <span class="neet-subject-label">SUBJECT 02</span>

                        <h3>Chemistry</h3>

                        <p>
                            Learn chemical principles, reactions
                            and important problem-solving methods.
                        </p>
                    </div>

                    <div class="neet-subject-body">
                        <h5>Preparation Focus</h5>
                        <ul>
                            <li>Chemical reactions</li>
                            <li>Important concepts</li>
                            <li>Equations and calculations</li>
                            <li>Chapter-wise revision</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="neet-subject-card h-100">
                    <div class="neet-subject-header physics-header">
                        <span class="neet-subject-symbol">MAT</span>
                        <span class="neet-subject-label">SUBJECT 03</span>

                        <h3>Mathematics</h3>

                        <p>
                            Strengthen mathematical skills through
                            formulas, methods and regular problem practice.
                        </p>
                    </div>

                    <div class="neet-subject-body">
                        <h5>Preparation Focus</h5>
                        <ul>
                            <li>Formula application</li>
                            <li>Step-by-step solutions</li>
                            <li>Problem-solving practice</li>
                            <li>Time management</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="neet-subject-card h-100">
                    <div class="neet-subject-header biology-header">
                        <span class="neet-subject-symbol">BIO</span>
                        <span class="neet-subject-label">SUBJECT 04</span>

                        <h3>Biology</h3>

                        <p>
                            Understand biological concepts and improve
                            diagram-based and descriptive answers.
                        </p>
                    </div>

                    <div class="neet-subject-body">
                        <h5>Preparation Focus</h5>
                        <ul>
                            <li>Important concepts</li>
                            <li>Scientific terminology</li>
                            <li>Diagrams and labelling</li>
                            <li>Written-answer practice</li>
                        </ul>
                    </div>
                </div>
            </div>

        </div>

        <p class="text-center mt-4">
            Subject availability depends on the student's Science group
            and the academy's course offerings.
        </p>
    </div>
</section>

<!-- PREPARATION PROCESS -->
<section class="neet-section">
    <div class="container">

        <div class="neet-section-heading text-center">
            <span class="neet-kicker">OUR LEARNING APPROACH</span>

            <h2>A Smarter Way to Prepare for Boards</h2>

            <p>
                Follow a structured learning process to understand
                concepts, practise regularly and prepare for examinations.
            </p>
        </div>

        <div class="neet-learning-timeline mt-5">

            <div class="neet-timeline-item">
                <div class="neet-timeline-number">01</div>
                <div>
                    <h4>Concept Learning</h4>
                    <p>
                        Understand the fundamentals of each chapter
                        before attempting more difficult questions.
                    </p>
                </div>
            </div>

            <div class="neet-timeline-item">
                <div class="neet-timeline-number">02</div>
                <div>
                    <h4>Regular Practice</h4>
                    <p>
                        Solve textbook exercises, numerical problems
                        and written-answer questions.
                    </p>
                </div>
            </div>

            <div class="neet-timeline-item">
                <div class="neet-timeline-number">03</div>
                <div>
                    <h4>Chapter-Wise Revision</h4>
                    <p>
                        Revise important concepts, formulas, reactions
                        and diagrams consistently.
                    </p>
                </div>
            </div>

            <div class="neet-timeline-item">
                <div class="neet-timeline-number">04</div>
                <div>
                    <h4>Mock Tests</h4>
                    <p>
                        Attempt suitable practice papers to improve
                        time management and answer-writing skills.
                    </p>
                </div>
            </div>

            <div class="neet-timeline-item">
                <div class="neet-timeline-number">05</div>
                <div>
                    <h4>Review and Improve</h4>
                    <p>
                        Identify mistakes, revisit difficult topics
                        and work on areas that need improvement.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- STUDY ROADMAP -->
<section class="neet-roadmap-section">
    <div class="container">

        <div class="neet-section-heading text-center">
            <span class="neet-kicker">PLAN YOUR STUDIES</span>

            <h2>Your Board Exam Preparation Roadmap</h2>

            <p>
                Organise your studies into manageable phases and
                make time for learning, practice and revision.
            </p>
        </div>

        <div class="row g-4 mt-3">

            <div class="col-md-6 col-lg-3">
                <div class="neet-roadmap-card h-100">
                    <span>PHASE 01</span>
                    <h4>Understand the Syllabus</h4>
                    <p>
                        Review your prescribed syllabus and plan
                        your subject-wise study schedule.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="neet-roadmap-card h-100">
                    <span>PHASE 02</span>
                    <h4>Learn Every Chapter</h4>
                    <p>
                        Build conceptual clarity and complete
                        chapter-based learning activities.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="neet-roadmap-card h-100">
                    <span>PHASE 03</span>
                    <h4>Practise and Revise</h4>
                    <p>
                        Solve questions, revise key topics and
                        strengthen your understanding.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="neet-roadmap-card h-100">
                    <span>PHASE 04</span>
                    <h4>Prepare for Exams</h4>
                    <p>
                        Practise sample papers and review your
                        performance before examinations.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- FAQ SECTION -->
<section class="neet-section neet-faq-section">
    <div class="container">

        <div class="neet-section-heading text-center">
            <span class="neet-kicker">COMMON QUESTIONS</span>

            <h2>Frequently Asked Questions</h2>

            <p>
                Find answers to common questions about 11th and
                12th Science Board Exam preparation.
            </p>
        </div>

        <div class="accordion neet-faq mt-4" id="boardFaq">

            <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#boardFaqOne"
                            aria-expanded="true"
                            aria-controls="boardFaqOne">
                        Which classes can enrol for Board Exam preparation?
                    </button>
                </h3>

                <div id="boardFaqOne"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#boardFaq">
                    <div class="accordion-body">
                        This page covers preparation for 11th and 12th
                        Science. Contact the academy to confirm the
                        currently available batches.
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button collapsed"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#boardFaqTwo"
                            aria-expanded="false"
                            aria-controls="boardFaqTwo">
                        Which subjects are covered?
                    </button>
                </h3>

                <div id="boardFaqTwo"
                     class="accordion-collapse collapse"
                     data-bs-parent="#boardFaq">
                    <div class="accordion-body">
                        Preparation may include Physics, Chemistry,
                        Mathematics or Biology, English and other
                        prescribed subjects, depending on the student's
                        Science group and the academy's course offering.
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button collapsed"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#boardFaqThree"
                            aria-expanded="false"
                            aria-controls="boardFaqThree">
                        How can students improve their exam performance?
                    </button>
                </h3>

                <div id="boardFaqThree"
                     class="accordion-collapse collapse"
                     data-bs-parent="#boardFaq">
                    <div class="accordion-body">
                        Understand concepts, practise textbook questions,
                        revise regularly, work on answer-writing skills
                        and review mistakes from practice tests.
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button collapsed"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#boardFaqFour"
                            aria-expanded="false"
                            aria-controls="boardFaqFour">
                        Are practice tests useful for board examinations?
                    </button>
                </h3>

                <div id="boardFaqFour"
                     class="accordion-collapse collapse"
                     data-bs-parent="#boardFaq">
                    <div class="accordion-body">
                        Practice tests can help students identify
                        learning gaps, practise time management and
                        become familiar with answering questions.
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ENQUIRY CTA -->
<section class="neet-enquiry-section" id="board-enquiry">
    <div class="container">
        <div class="neet-enquiry-content text-center">

            <span class="neet-eyebrow">
                REVOLUTION SCIENCE ACADEMY
            </span>

            <h2>Ready to Prepare for Your Board Exams?</h2>

            <p>
                Contact Revolution Science Academy to learn about
                available batches, subjects, schedules and admissions
                for 11th and 12th Science.
            </p>

            <a asp-controller="Contact"
               asp-action="Index"
               class="btn btn-warning btn-lg">
                Enquire About the Course
                <i class="bi bi-arrow-right ms-2"></i>
            </a>

        </div>
    </div>
</section>
