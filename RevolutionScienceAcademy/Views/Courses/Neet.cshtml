@{
    ViewData["Title"] = "NEET UG Medical Entrance Coaching";
}

<!-- HERO SECTION -->
<section class="neet-hero">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="neet-eyebrow">
                    REVOLUTION SCIENCE ACADEMY
                </span>

                <h1>
                    Your Dream of Medicine.
                    <span>Starts with the Right Preparation.</span>
                </h1>

                <p class="neet-hero-description">
                    Prepare for NEET UG with a strong foundation in Biology,
                    Physics and Chemistry. Understand concepts, practise
                    important questions and develop the confidence needed
                    for your medical entrance examination.
                </p>

                <div class="neet-hero-actions">
                    <a href="#neet-course" class="btn btn-warning btn-lg">
                        Explore NEET Course
                    </a>

                    @* <a href="#neet-enquiry"
                       class="btn btn-outline-light btn-lg">
                        Enquire Now
                    </a> *@
                </div>

                <div class="neet-hero-highlights">
                    <div>
                        <strong>Biology</strong>
                        <span>Life Sciences</span>
                    </div>

                    <div>
                        <strong>Physics</strong>
                        <span>Concepts & Numericals</span>
                    </div>

                    <div>
                        <strong>Chemistry</strong>
                        <span>Reactions & Concepts</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="neet-hero-image">
                    <img src="~/images/courses/neet.jpg"
                         asp-append-version="true"
                         alt="Students preparing for medical entrance examinations"
                         class="img-fluid" />

                    <div class="neet-image-caption">
                        <span>YOUR MEDICAL JOURNEY</span>
                        <strong>Learn with Purpose. Prepare with Confidence.</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- COURSE INTRODUCTION -->
<section class="neet-section" id="neet-course">
    <div class="container">
        <div class="neet-section-heading text-center">
            <span class="neet-kicker">UNDERSTAND YOUR GOAL</span>

            <h2>What Is the NEET UG Preparation Course?</h2>

            <p>
                NEET UG stands for National Eligibility cum Entrance Test
                (Undergraduate). It is the entrance examination used for
                admission to MBBS, BDS and other undergraduate medical
                programmes covered by the applicable admission rules.
            </p>

            <p>
                Preparation focuses on understanding the prescribed syllabus,
                applying concepts, solving questions accurately and revising
                consistently throughout the academic year.
            </p>
        </div>

        <div class="row g-4 mt-3">
            <div class="col-md-4">
                <div class="neet-info-card">
                    <div class="neet-card-number">01</div>

                    <h4>Conceptual Learning</h4>

                    <p>
                        Learn the fundamentals of Biology, Physics and
                        Chemistry so you can understand why an answer
                        is correct, rather than relying only on memorisation.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="neet-info-card">
                    <div class="neet-card-number">02</div>

                    <h4>Question Practice</h4>

                    <p>
                        Practise syllabus-based questions and learn to
                        identify key information, eliminate incorrect
                        options and improve accuracy.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="neet-info-card">
                    <div class="neet-card-number">03</div>

                    <h4>Revision & Assessment</h4>

                    <p>
                        Review completed chapters, analyse mistakes and
                        use appropriate practice tests to monitor your
                        preparation progress.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- WHO CAN PREPARE -->
<section class="neet-audience-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-5">
                <span class="neet-kicker">START AT THE RIGHT TIME</span>

                <h2>Build Your Foundation for Medical Entrance Exams</h2>

                <p>
                    A consistent preparation plan helps students understand
                    difficult topics, balance school studies and develop
                    good revision habits.
                </p>

                <p>
                    The right study plan depends on your current academic
                    level, target examination year and the time available.
                </p>
            </div>

            <div class="col-lg-7">
                <div class="neet-audience-grid">
                    <div class="neet-audience-card">
                        <span>01</span>
                        <h4>Class 11 Students</h4>
                        <p>
                            Begin with foundational concepts and establish
                            a consistent routine alongside school studies.
                        </p>
                    </div>

                    <div class="neet-audience-card">
                        <span>02</span>
                        <h4>Class 12 Students</h4>
                        <p>
                            Cover the relevant syllabus, practise questions
                            and organise revision around school examinations.
                        </p>
                    </div>

                    <div class="neet-audience-card">
                        <span>03</span>
                        <h4>Repeat Aspirants</h4>
                        <p>
                            Identify weak chapters, revisit concepts and
                            make a focused plan based on previous preparation.
                        </p>
                    </div>

                    <div class="neet-audience-card">
                        <span>04</span>
                        <h4>Future Healthcare Professionals</h4>
                        <p>
                            Explore medical and allied healthcare study
                            pathways and check the eligibility requirements
                            for the courses you want to pursue.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- SUBJECTS -->
<section class="neet-section neet-subjects-section" id="neet-subjects">
    <div class="container">
        <div class="neet-section-heading text-center">
            <span class="neet-kicker">EXPLORE YOUR SUBJECTS</span>

            <h2>Detailed NEET Subject Guide</h2>

            <p>
                Each subject needs a different preparation approach.
                Explore the topic examples and skills students commonly
                work on during entrance exam preparation.
            </p>
        </div>

        <div class="row g-4 mt-3">
            <!-- BIOLOGY -->
            <div class="col-lg-4">
                <div class="neet-subject-card">
                    <div class="neet-subject-header biology-header">
                        <span class="neet-subject-symbol">BIO</span>
                        <span class="neet-subject-label">SUBJECT 01</span>

                        <h3>Biology</h3>

                        <p>
                            Understand life, living organisms and
                            the processes that sustain them.
                        </p>
                    </div>

                    <div class="neet-subject-body">
                        <h5>Example topic areas</h5>

                        <ul>
                            <li>Cell Structure and Function</li>
                            <li>Biomolecules and Cell Division</li>
                            <li>Plant Physiology</li>
                            <li>Human Physiology</li>
                            <li>Reproduction</li>
                            <li>Genetics and Evolution</li>
                            <li>Biology and Human Welfare</li>
                            <li>Ecology and Environment</li>
                        </ul>

                        <div class="neet-skill-box">
                            <strong>Preparation focus</strong>

                            <p>
                                Understand biological processes, learn
                                scientific terminology and revise concepts
                                with diagrams and chapter-based questions.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PHYSICS -->
            <div class="col-lg-4">
                <div class="neet-subject-card">
                    <div class="neet-subject-header physics-header">
                        <span class="neet-subject-symbol">PHY</span>
                        <span class="neet-subject-label">SUBJECT 02</span>

                        <h3>Physics</h3>

                        <p>
                            Apply scientific principles and mathematical
                            reasoning to solve numerical problems.
                        </p>
                    </div>

                    <div class="neet-subject-body">
                        <h5>Example topic areas</h5>

                        <ul>
                            <li>Units and Measurements</li>
                            <li>Motion and Laws of Motion</li>
                            <li>Work, Energy and Power</li>
                            <li>Thermodynamics</li>
                            <li>Electrostatics</li>
                            <li>Current Electricity</li>
                            <li>Optics</li>
                            <li>Modern Physics</li>
                        </ul>

                        <div class="neet-skill-box">
                            <strong>Preparation focus</strong>

                            <p>
                                Understand formulas, practise numerical
                                problems and learn to apply concepts
                                accurately under time constraints.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CHEMISTRY -->
            <div class="col-lg-4">
                <div class="neet-subject-card">
                    <div class="neet-subject-header chemistry-header">
                        <span class="neet-subject-symbol">CHE</span>
                        <span class="neet-subject-label">SUBJECT 03</span>

                        <h3>Chemistry</h3>

                        <p>
                            Study matter, chemical reactions and
                            the principles governing substances.
                        </p>
                    </div>

                    <div class="neet-subject-body">
                        <h5>Example topic areas</h5>

                        <ul>
                            <li>Atomic Structure</li>
                            <li>Chemical Bonding</li>
                            <li>Thermodynamics</li>
                            <li>Equilibrium</li>
                            <li>Solutions</li>
                            <li>Electrochemistry</li>
                            <li>Organic Chemistry</li>
                            <li>Important Inorganic Topics</li>
                        </ul>

                        <div class="neet-skill-box">
                            <strong>Preparation focus</strong>

                            <p>
                                Connect chemical concepts, understand
                                reactions and practise calculations
                                and application-based questions.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="neet-syllabus-notice mt-4">
            <strong>Important:</strong>
            These are example topic areas, not a complete official syllabus.
            The applicable NEET UG syllabus can change from year to year.

            <a href="https://neet.nta.nic.in/"
               target="_blank"
               rel="noopener noreferrer">
                Check the official NEET UG website ↗
            </a>

            <a href="https://www.nmc.org.in/"
               target="_blank"
               rel="noopener noreferrer">
                Visit the National Medical Commission ↗
            </a>
        </div>
    </div>
</section>

<!-- LEARNING PROCESS -->
<section class="neet-section">
    <div class="container">
        <div class="neet-section-heading text-center">
            <span class="neet-kicker">HOW PREPARATION WORKS</span>

            <h2>From Your First Chapter to Exam Readiness</h2>

            <p>
                Use a step-by-step learning process to develop understanding,
                practise consistently and monitor your progress.
            </p>
        </div>

        <div class="neet-learning-timeline mt-5">
            <div class="neet-timeline-item">
                <div class="neet-timeline-number">01</div>

                <div>
                    <h4>Understand the Concept</h4>

                    <p>
                        Learn the fundamentals of a topic before moving
                        to detailed explanations and more difficult questions.
                    </p>
                </div>
            </div>

            <div class="neet-timeline-item">
                <div class="neet-timeline-number">02</div>

                <div>
                    <h4>Practise Chapter-Wise Questions</h4>

                    <p>
                        Apply what you have learned to questions related
                        to the chapter and review explanations for mistakes.
                    </p>
                </div>
            </div>

            <div class="neet-timeline-item">
                <div class="neet-timeline-number">03</div>

                <div>
                    <h4>Revise Important Topics</h4>

                    <p>
                        Revisit notes, diagrams, formulas and difficult
                        concepts on a regular revision schedule.
                    </p>
                </div>
            </div>

            <div class="neet-timeline-item">
                <div class="neet-timeline-number">04</div>

                <div>
                    <h4>Attempt Practice Tests</h4>

                    <p>
                        Use suitable mock tests to assess your understanding,
                        accuracy and time management.
                    </p>
                </div>
            </div>

            <div class="neet-timeline-item">
                <div class="neet-timeline-number">05</div>

                <div>
                    <h4>Analyse and Improve</h4>

                    <p>
                        Identify recurring errors and adjust your study
                        plan according to the topics that need more practice.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- STUDY ROADMAP -->
<section class="neet-roadmap-section">
    <div class="container">
        <div class="neet-section-heading text-center">
            <span class="neet-kicker">PLAN YOUR STUDIES</span>

            <h2>A Practical NEET Preparation Roadmap</h2>

            <p>
                The following phases are a suggested study approach.
                Your actual timetable should match the applicable syllabus,
                examination date and academic commitments.
            </p>
        </div>

        <div class="row g-4 mt-3">
            <div class="col-md-6 col-lg-3">
                <div class="neet-roadmap-card">
                    <span>PHASE 01</span>
                    <h4>Build Your Foundation</h4>
                    <p>
                        Understand basic concepts and organise notes
                        for the relevant subjects and chapters.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="neet-roadmap-card">
                    <span>PHASE 02</span>
                    <h4>Complete Topic Practice</h4>
                    <p>
                        Practise chapter-based questions and identify
                        concepts that require additional explanation.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="neet-roadmap-card">
                    <span>PHASE 03</span>
                    <h4>Revise and Consolidate</h4>
                    <p>
                        Revisit completed chapters and use regular
                        revision to reinforce your understanding.
                    </p>
                </div>
            </div>

            <div class="col-md-6 col-lg-3">
                <div class="neet-roadmap-card">
                    <span>PHASE 04</span>
                    <h4>Test and Refine</h4>
                    <p>
                        Take practice tests, review mistakes and focus
                        on your remaining learning gaps.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

