<!-- FAQ -->
<section class="neet-section neet-faq-section">
    <div class="container">
        <div class="neet-section-heading text-center">
            <span class="neet-kicker">COMMON QUESTIONS</span>

            <h2>Frequently Asked Questions</h2>

            <p>
                Answers to common questions about NEET preparation.
            </p>
        </div>

        <div class="accordion neet-faq mt-4" id="neetFaq">

            <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#neetFaqOne"
                            aria-expanded="true"
                            aria-controls="neetFaqOne">
                        What is NEET UG?
                    </button>
                </h3>

                <div id="neetFaqOne"
                     class="accordion-collapse collapse show"
                     data-bs-parent="#neetFaq">
                    <div class="accordion-body">
                        NEET UG is the National Eligibility cum Entrance
                        Test for undergraduate medical admissions covered
                        by the applicable rules. Check the current official
                        information bulletin for details.
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button collapsed"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#neetFaqTwo"
                            aria-expanded="false"
                            aria-controls="neetFaqTwo">
                        Which subjects are important for NEET preparation?
                    </button>
                </h3>

                <div id="neetFaqTwo"
                     class="accordion-collapse collapse"
                     data-bs-parent="#neetFaq">
                    <div class="accordion-body">
                        Biology, Physics and Chemistry are the core
                        subjects in NEET UG preparation. Candidates should
                        follow the official syllabus for their examination year.
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button collapsed"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#neetFaqThree"
                            aria-expanded="false"
                            aria-controls="neetFaqThree">
                        When should I start preparing for NEET?
                    </button>
                </h3>

                <div id="neetFaqThree"
                     class="accordion-collapse collapse"
                     data-bs-parent="#neetFaq">
                    <div class="accordion-body">
                        Many students begin building their foundation
                        during Class 11. The best plan depends on your
                        academic level, target year and study requirements.
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button collapsed"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#neetFaqFour"
                            aria-expanded="false"
                            aria-controls="neetFaqFour">
                        How can I improve my preparation?
                    </button>
                </h3>

                <div id="neetFaqFour"
                     class="accordion-collapse collapse"
                     data-bs-parent="#neetFaq">
                    <div class="accordion-body">
                        Understand concepts, practise syllabus-based
                        questions, revise regularly, analyse mistakes
                        and use appropriate mock tests to track progress.
                    </div>
                </div>
            </div>

            <div class="accordion-item">
                <h3 class="accordion-header">
                    <button class="accordion-button collapsed"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#neetFaqFive"
                            aria-expanded="false"
                            aria-controls="neetFaqFive">
                        Where can I check the official NEET syllabus?
                    </button>
                </h3>

                <div id="neetFaqFive"
                     class="accordion-collapse collapse"
                     data-bs-parent="#neetFaq">
                    <div class="accordion-body">
                        Visit the
                        <a href="https://neet.nta.nic.in/"
                           target="_blank"
                           rel="noopener noreferrer">
                            official NEET UG website
                        </a>
                        and check the applicable examination-year
                        syllabus and information bulletin.
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

