                </div>
            </div>

            <div class="col-md-4">
                <div class="rsa-focus-item">

                    <div class="rsa-card-icon">
                        <i class="bi bi-bullseye"></i>
                    </div>

                    <div>
                        <h5 class="rsa-focus-title">
                            Comprehensive Curriculum
                        </h5>

                        <p>
                            JEE/NEET and Board exam focused
                        </p>
                    </div>

                </div>
            </div>

            <div class="col-md-4">
                <div class="rsa-focus-item">

                    <div class="rsa-card-icon">
                        <i class="bi bi-bar-chart-line-fill"></i>
                    </div>

                    <div>
                        <h5 class="rsa-focus-title">
                            Result-Oriented Approach
                        </h5>

                        <p>
                            85%+ students securing top ranks
                        </p>
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>


