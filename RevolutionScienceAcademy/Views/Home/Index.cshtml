@{
    ViewData["Title"] = "Home";
}

<!-- =========================
     HERO SECTION
========================= -->
<section class="rsa-hero">
    <div class="container">
        <div class="row align-items-center g-0">

            <!-- LEFT CONTENT -->
            <div class="col-lg-6">
                <div class="rsa-hero-content">

                    <div class="rsa-hero-label">
                        <i class="bi bi-mortarboard-fill me-2"></i>
                        REVOLUTION ACADEMY
                    </div>

                    <h1 class="rsa-hero-title">
                        Building
                        <span>Future Scholars</span>
                        for JEE/NEET
                    </h1>

                    <p class="rsa-hero-description">
                        Our intensive programs for 11th &amp; 12th Science students
                        combine <strong>conceptual clarity</strong> with
                        <strong>competitive exam preparation.</strong>
                    </p>

                    <div class="rsa-hero-quote">
                        <i class="bi bi-quote"></i>
                        <div>
                            <p>
                                “Success is where preparation and opportunity meet.”
                            </p>
                            <span>— Bobby Unser</span>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-3 mt-4">

                       
                        <button type="button"
                                class="rsa-hero-primary border-0"
                                data-bs-toggle="modal"
                                data-bs-target="#registerModal">
                            <i class="bi bi-person-plus-fill me-2"></i>
                            Register Now
                            <i class="bi bi-arrow-right ms-2"></i>
                        </button>

                        @* <a asp-controller="Courses"
                           asp-action="Index"
                           class="rsa-hero-secondary">
                            <i class="bi bi-eye-fill me-2"></i>
                            View Programs
                        </a> *@

                    </div>

                </div>
            </div>

            <!-- RIGHT IMAGE -->
            <div class="col-lg-6">
                <div class="rsa-hero-image-area">

                    <img src="~/images/lecture/lecture.jpg"
                         alt="Revolution Academy Students"
                         class="rsa-hero-image" />

                    <!-- Result Card -->
                    <div class="rsa-hero-card">

                        <div class="rsa-hero-card-icon">
                            <i class="bi bi-trophy-fill"></i>
                        </div>

                        <div>
                            <strong>Proven Results</strong>
                            <span>1500+ JEE/NEET Selections</span>
                        </div>

                    </div>

                </div>
            </div>

        </div>
    </div>
</section>


