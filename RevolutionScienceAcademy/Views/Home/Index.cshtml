<!-- =========================
     COURSES PREVIEW
========================= -->
<section class="rsa-section rsa-section-light">

    <div class="container">

        <div class="d-flex flex-column flex-md-row
            justify-content-between align-items-md-end
            gap-3 mb-5">

            <div>

                <span class="rsa-section-label">
                    ACADEMIC PROGRAMS
                </span>

                <h2 class="rsa-section-title mb-2">
                    Our <span>Courses</span>
                </h2>

                <p class="rsa-section-description mb-0">
                    Scientifically designed programs for board exams,
                    JEE and NEET preparation.
                </p>

            </div>

            <a asp-controller="Courses"
               asp-action="Index"
               class="btn btn-outline-primary rounded-pill px-4">
                View All Courses
                <i class="bi bi-arrow-right ms-2"></i>
            </a>

        </div>


        <div class="row g-4">

            <!-- 11TH -->
            <div class="col-lg-4 col-md-6">

                <div class="rsa-course-card h-100">

                    <img src="~/images/courses/11th-science.jpg"
                         alt="11th Science Foundation"
                         class="rsa-course-image" />

                    <div class="rsa-course-content">

                        <span class="badge rounded-pill mb-3">
                            FOUNDATION
                        </span>

                        <h3 class="rsa-course-title">
                            11th Science Foundation
                        </h3>

                        <p class="rsa-course-description">
                            Build strong fundamentals in Physics,
                            Chemistry and Mathematics with CBSE/
                            State Board aligned curriculum.
                        </p>

                        <a asp-controller="Courses"
                           asp-action="EleventhScience"
                           class="btn btn-sm btn-outline-primary rounded-pill px-3">
                            Explore Course
                            <i class="bi bi-arrow-right ms-1"></i>
                        </a>

                    </div>

                </div>

            </div>


            <!-- 12TH -->
            <div class="col-lg-4 col-md-6">

                <div class="rsa-course-card h-100">

                    <img src="~/images/courses/12th-science.jpg"
                         alt="12th Science Intensive"
                         class="rsa-course-image" />

                    <div class="rsa-course-content">

                        <span class="badge rounded-pill mb-3">
                            INTENSIVE
                        </span>

                        <h3 class="rsa-course-title">
                            12th Science Intensive
                        </h3>

                        <p class="rsa-course-description">
                            Complete syllabus coverage with competitive
                            exam preparation for board excellence and
                            JEE/NEET success.
                        </p>

                        <a asp-controller="Courses"
                           asp-action="TwelfthScience"
                           class="btn btn-sm btn-outline-primary rounded-pill px-3">
                            Explore Course
                            <i class="bi bi-arrow-right ms-1"></i>
                        </a>

                    </div>

                </div>

            </div>


            <!-- JEE -->
            <div class="col-lg-4 col-md-6">

                <div class="rsa-course-card h-100">

                    <img src="~/images/courses/jee.jpg"
                         alt="JEE Mains and Advanced"
                         class="rsa-course-image" />

                    <div class="rsa-course-content">

                        <span class="badge rounded-pill mb-3">
                            ENGINEERING
                        </span>

                        <h3 class="rsa-course-title">
                            JEE Mains &amp; Advanced
                        </h3>

                        <p class="rsa-course-description">
                            Specialized program for engineering
                            aspirants with advanced problem-solving
                            techniques and test strategies.
                        </p>

                        <a asp-controller="Courses"
                           asp-action="Jee"
                           class="btn btn-sm btn-outline-primary rounded-pill px-3">
                            Explore Course
                            <i class="bi bi-arrow-right ms-1"></i>
                        </a>

                    </div>

                </div>

            </div>


            <!-- NEET -->
            <div class="col-lg-4 col-md-6">

                <div class="rsa-course-card h-100">

                    <img src="~/images/courses/neet.jpg"
                         alt="NEET Preparation"
                         class="rsa-course-image" />

                    <div class="rsa-course-content">

                        <span class="badge rounded-pill mb-3">
                            MEDICAL
                        </span>

                        <h3 class="rsa-course-title">
                            NEET Preparation
                        </h3>

                        <p class="rsa-course-description">
                            Comprehensive medical entrance coaching
                            with NCERT focus and advanced biology
                            concepts.
                        </p>

                        <a asp-controller="Courses"
                           asp-action="Neet"
                           class="btn btn-sm btn-outline-primary rounded-pill px-3">
                            Explore Course
                            <i class="bi bi-arrow-right ms-1"></i>
                        </a>

                    </div>

                </div>

            </div>


            <!-- BOARD -->
            <div class="col-lg-4 col-md-6">

                <div class="rsa-course-card h-100">

                    <img src="~/images/courses/board-exam.jpg"
                         alt="Board Exam Special"
                         class="rsa-course-image" />

                    <div class="rsa-course-content">

                        <span class="badge rounded-pill mb-3">
                            BOARD EXAM
                        </span>

                        <h3 class="rsa-course-title">
                            Board Exam Special
                        </h3>

                        <p class="rsa-course-description">
                            Crash course for 12th board exams with
                            focused revision, important questions
                            and answer writing practice.
                        </p>

                        <a asp-controller="Courses"
                           asp-action="BoardExam"
                           class="btn btn-sm btn-outline-primary rounded-pill px-3">
                            Explore Course
                            <i class="bi bi-arrow-right ms-1"></i>
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


